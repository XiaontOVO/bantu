# 原型运行配置（不要把真实 Key 提交到仓库）
PORT=8787
HOST=127.0.0.1
# 非回环监听自动启用邀请码；局域网开放脚本每次强制使用新随机码。
BANTU_RANDOM_ACCESS_CODE=false
# 仅固定口令部署场景填写；随机开放模式忽略此项，本机回环访问默认免门禁。
BANTU_ACCESS_CODE=
# 默认不注入社区演示帖子；需要演示内容时显式改为 true。
BANTU_SEED_DEMO=false

# 在线能力预留；当前 P0 原型在未配置时不注册真实供应商工具。
MODEL_PROVIDER=
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_API_FORMAT=chat-completions
MODEL_THINKING=off
MODEL_THINKING_FORMAT=auto
MODEL_THINKING_EFFORT=high

# 地点目录仍使用本地收录数据。
PLACE_PROVIDER=demo
# 无需 Key：步行与驾车路线默认调用 FOSSGIS 的 OpenStreetMap OSRM 服务。
# 填写高德 Web 服务 Key 后，路线改用高德（含公交），地点搜索也启用高德。
AMAP_API_KEY=
WEATHER_PROVIDER=disabled

DATABASE_URL=

# 本地恢复演练；生产 PostgreSQL 适配器后续替换同一 StateStore 语义。
STATE_STORE=memory
STATE_FILE=data/bantu-state.sqlite
# Agent 对话请求限额（每账号，固定窗口）。停止任务不计入。
AGENT_REQUESTS_PER_MINUTE=30
AGENT_REQUESTS_PER_DAY=300

# Weather: Open-Meteo public endpoint for non-commercial invitation testing.
# API documentation and attribution: https://open-meteo.com/en/docs
# Set disabled to turn off online forecasts.
WEATHER_PROVIDER=open_meteo
